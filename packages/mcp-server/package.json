{
  "name": "mcp-server",
  "version": "1.0.0",
  "description": "MCP tool for data analysis and charts. Deterministic: no LLM, no credentials.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "start": "tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "build-catalog": "tsx src/buildCatalog.ts",
    "csv-to-parquet": "tsx src/csvToParquet.ts",
    "preview-chart": "tsx src/previewChart.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "files": [
    "src",
    "skills"
  ],
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.5",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@uwdata/mosaic-sql": "^0.30.0",
    "flint-chart": "^0.5.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0"
  }
}
