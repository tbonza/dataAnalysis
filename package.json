{
  "name": "demo",
  "version": "1.0.0",
  "description": "MCP data-analysis and chart tool, a deep-agent server that consumes it, and a chat client",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "mcp": "pnpm --filter mcp-server start",
