    "build-catalog": "pnpm --filter mcp-server build-catalog",
    "csv-to-parquet": "pnpm --filter mcp-server csv-to-parquet",
    "preview-chart": "pnpm --filter mcp-server preview-chart"
  },
  "keywords": [],
  "author": "",
